PORT=3000
HOSTNAME=0.0.0.0

# Redis storage (one of the options below is required on Vercel).
# Option 1: Upstash Redis (recommended for Vercel - HTTP-based, no TCP issues)
# Create at https://upstash.com or via Vercel Dashboard → Storage → Upstash
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Option 2: Standard Redis via ioredis (for Railway/Docker/local)
# REDIS_URL=redis://localhost:6379

# Optional Sentry monitoring
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
